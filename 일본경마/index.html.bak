                record: "14전 6승 [6-1-1-6]", earnings: "12억 5,400만 엔",
                style: "선입 / 추입", dist: "2,000m ~ 2,500m",
                sire: "하츠 크라이", dam: "더스트 앤 다이아몬즈", damsire: "빈디케이션",
                title: "이퀴녹스를 꺾었던 유일한 일본 더비마, 극강의 스퍼트",
                story: "2022 더비에서 레코드로 우승. 타케 유타카 기수와 함께 2023 아리마 기념, 2024 텐노상(가을)에서 막판 32.5초 초광속 스퍼트로 대역전극을 썼습니다.",
                g1: ["21 아사히배 FS", "22 일본 더비", "23 아리마 기념", "24 텐노상(가을)"],
                stats: [97, 94, 99, 96, 96, 95]
            }
        };

        let radarChart = null;
        const labels = ['스피드', '스태미너', '순발력', '근성', '파워', '지능'];

        function updateHorseProfile(name) {
            const h = HORSES[name];
            document.getElementById('horseName').innerHTML = `${name} <span class="text-base text-slate-400 font-normal">(${h.jp})</span>`;
            document.getElementById('horseBadge').innerText = h.title;
            document.getElementById('horseCoat').innerText = h.coat;
            document.getElementById('horseBasic').innerText = `${h.birth}년생 | ${h.sex} | ${h.trainer}`;
            document.getElementById('horseStyle').innerText = h.style;
            document.getElementById('horseDist').innerText = h.dist;
            document.getElementById('horseRecord').innerText = h.record;
            document.getElementById('horseMoney').innerText = h.earnings;
            document.getElementById('horsePedigree').innerHTML = `부: <strong>${h.sire}</strong> × 모: <strong>${h.dam}</strong> (모부: ${h.damsire})`;
            document.getElementById('horseStory').innerText = h.story;

            const g1Container = document.getElementById('horseG1List');
            g1Container.innerHTML = h.g1.map(g => `<span class="px-2.5 py-1 bg-amber-500/10 text-amber-500 border border-amber-500/30 rounded-lg text-xs font-semibold">🏆 ${g}</span>`).join('');

            // 차트 업데이트
            if (radarChart) {
                radarChart.data.datasets[0].label = name;
                radarChart.data.datasets[0].data = h.stats;
                radarChart.update();
            } else {
                const ctx = document.getElementById('horseRadarChart').getContext('2d');
                radarChart = new Chart(ctx, {
                    type: 'radar',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: name,
                            data: h.stats,
                            backgroundColor: 'rgba(59, 130, 246, 0.25)',
                            borderColor: '#3b82f6',
                            pointBackgroundColor: '#3b82f6',
                            borderWidth: 2
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            r: {
                                min: 70, max: 100,
                                ticks: { stepSize: 10, display: false },
                                grid: { color: 'rgba(255, 255, 255, 0.1)' },
                                pointLabels: { font: { size: 11 }, color: '#94a3b8' }
                            }
                        },
                        plugins: { legend: { display: false } }
                    }
                });
            }
        }

        document.getElementById('horseSelect').addEventListener('change', (e) => {
            updateHorseProfile(e.target.value);
        });

