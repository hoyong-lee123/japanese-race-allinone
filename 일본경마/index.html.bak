                story: "사츠키상 진흙탕 인코스 워프 주법과 타카라즈카 2연패의 실력파이자, 120억 엔 마권 공중분해 기행의 주인공인 영원한 아이돌.",
                g1: ["12 사츠키상", "12 킷카상", "12 아리마 기념", "13 타카라즈카", "14 타카라즈카", "15 텐노상(봄)"],
                stats: [91, 100, 88, 98, 99, 75]
            },
            "사일런스 스즈카": {
                jp: "サイレンススズカ (Silence Suzuka)",
                birth: 1994, sex: "수말 (牡)", coat: "밤색 (栗毛)",
