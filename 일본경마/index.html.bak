        function renderJockeys() {
            const grid = document.getElementById('jockeyGrid');
            grid.innerHTML = JOCKEYS.map(j => `
                <div class="bg-white dark:bg-darkCard p-6 rounded-2xl border border-slate-200 dark:border-darkBorder shadow-sm">
                    <div class="flex justify-between items-center">
