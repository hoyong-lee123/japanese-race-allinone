                story: "초반부터 후속 마군을 10마신 이상 따돌리고 질주하는 경이적 스피드. 1998년 킨코상 대차 우승과 비운의 텐노상(가을)으로 전설이 되었습니다.",
                g1: ["98 타카라즈카 기념"],
                stats: [100, 89, 94, 95, 92, 93]
            },
            "토카이 테이오": {
