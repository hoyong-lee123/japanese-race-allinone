                birth: 1988, sex: "수말 (牡)", coat: "갈색 (鹿毛)",
                trainer: "마츠모토 쇼이치", jockey: "타케 유타카 / 안도 카츠미",
                record: "12전 9승 [9-0-0-3]", earnings: "6억 2,139만 엔",
                style: "선행 (先行)", dist: "2,000m ~ 2,500m",
                sire: "심볼리 루돌프", dam: "토카이 내추럴", damsire: "나이스 댄서",
                title: "제왕의 혈통, 세 번의 골절을 이겨낸 기적의 명마",
                story: "황제 심볼리 루돌프의 아들로 무패 2관 달성. 세 번의 골절을 딛고 364일 만의 복귀전 1993 아리마 기념에서 감동의 역전 우승을 차지했습니다.",
                g1: ["91 사츠키상", "91 일본 더비", "92 재팬 컵", "93 아리마 기념 (기적의 부활)"],
                stats: [96, 92, 97, 100, 93, 95]
            },
            "소다시": {
                jp: "ソダシ (Sodashi)",
                birth: 2018, sex: "암말 (牝)", coat: "백모 (白毛)",
