                record: "20전 12승 [12-2-4-2]", earnings: "18억 6,687만 엔",
                style: "도주 / 선행", dist: "2,000m ~ 3,200m",
                sire: "블랙 타이드", dam: "슈거 하트", damsire: "사쿠라 바쿠신 오",
                title: "국민적 엔카 가수의 말, 불굴의 근성을 지닌 제왕",
                story: "엔카 가수 키타지마 사부로의 소유마. 540kg 거구로 전방에서 끈질기게 버티며 G1 7승을 달성했고, 종마로서 이퀴녹스를 낳았습니다.",
                g1: ["15 킷카상", "16 텐노상(봄)", "16 재팬 컵", "17 오사카배", "17 텐노상(봄)", "17 텐노상(가을)", "17 아리마 기념"],
                stats: [93, 99, 90, 100, 98, 96]
            },
            "골드 쉽": {
                jp: "ゴールドシップ (Gold Ship)",
                birth: 2009, sex: "수말 (牡)", coat: "회모 (芦毛)",
                trainer: "스가이 나오스케 (릿토)", jockey: "우치다 히로유키",
                record: "28전 13승 [13-3-2-10]", earnings: "13억 9,776만 엔",
                style: "추입 / 롱스퍼트 (워프)", dist: "2,200m ~ 3,200m",
                sire: "스테이 골드", dam: "포인트 플래그", damsire: "메지로 맥퀸",
