                record: "16전 9승 [9-1-0-6]", earnings: "3억 8,432만 엔",
                style: "대도주 (大逃げ)", dist: "1,800m ~ 2,200m",
                sire: "선데이 사일런스", dam: "와키아", damsire: "미스와키",
