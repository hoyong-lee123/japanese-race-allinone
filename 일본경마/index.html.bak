        let map = null;
        let currentMarker = null;

        function initMap() {
            map = L.map('map').setView([35.6628, 139.4851], 13);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap'
            }).addTo(map);

            currentMarker = L.marker([35.6628, 139.4851]).addTo(map).bindPopup("<b>도쿄 경마장</b><br>東京競馬場").openPopup();
        }

        function selectTrack(name) {
            const t = TRACKS[name];
            map.setView([t.lat, t.lng], 14);
            currentMarker.setLatLng([t.lat, t.lng]).setPopupContent(`<b>${name}</b><br>${t.jp}`).openPopup();

            document.getElementById('trackDetailBox').innerHTML = `
                <div>
                    <h3 class="text-2xl font-extrabold">${name}</h3>
                    <p class="text-sm text-slate-400 mt-0.5">${t.jp} | 📍 ${t.loc}</p>
                    <div class="grid grid-cols-2 gap-3 my-4">
                        <div class="p-3 bg-slate-50 dark:bg-slate-800/40 rounded-xl">
                            <span class="text-xs text-slate-400">잔디 직선 거리</span>
                            <p class="font-bold text-blue-500 mt-0.5">${t.turf}</p>
                        </div>
                        <div class="p-3 bg-slate-50 dark:bg-slate-800/40 rounded-xl">
                            <span class="text-xs text-slate-400">코스 고저차</span>
                            <p class="font-bold text-amber-500 mt-0.5">${t.diff}</p>
                        </div>
                        <div class="p-3 bg-slate-50 dark:bg-slate-800/40 rounded-xl">
                            <span class="text-xs text-slate-400">더트 직선</span>
                            <p class="font-bold mt-0.5">${t.dirt}</p>
                        </div>
                        <div class="p-3 bg-slate-50 dark:bg-slate-800/40 rounded-xl">
                            <span class="text-xs text-slate-400">유리한 각질</span>
                            <p class="font-bold text-emerald-500 mt-0.5">${t.style}</p>
                        </div>
                    </div>
                    <div class="p-4 bg-slate-50 dark:bg-slate-800/40 rounded-xl text-sm leading-relaxed">
                        <p class="text-xs font-semibold text-slate-400 mb-1">🏟️ 코스 공략 팁</p>
                        ${t.feat}
                    </div>
                </div>
            `;
        }

        function renderTrackButtons() {
            const container = document.getElementById('trackButtons');
            container.innerHTML = Object.keys(TRACKS).map(name => `
                <button onclick="selectTrack('${name}')" class="px-3 py-1.5 bg-slate-100 dark:bg-slate-800 hover:bg-blue-500 hover:text-white rounded-xl text-xs font-semibold transition">
                    ${name}
                </button>
            `).join('');
            selectTrack("도쿄 경마장");
        }

        // ==========================
        // 5. 마권 종류 & 계산기
        // ==========================
        const BET_TYPES = [
            { name: "단승 (単勝)", jp: "単勝", desc: "1착마 1두 적중", rate: "80%", diff: "★☆☆☆☆", tip: "초보자 필수 마권" },
            { name: "연승 / 복승식 (複勝)", jp: "複勝", desc: "3착 이내 들어올 1두 적중", rate: "80%", diff: "★☆☆☆☆", tip: "적중 확률 최고, 복병마 노림수" },
            { name: "복연승 / 와이드 (ワイド)", jp: "ワイド", desc: "3착 내 들어올 2두 적중 (순서 무관)", rate: "77.5%", diff: "★★☆☆☆", tip: "중급자들의 최고 애용 마권" },
            { name: "마번복승 / 우마렌 (馬連)", jp: "馬連", desc: "1, 2착마 2두 적중 (순서 무관)", rate: "77.5%", diff: "★★★☆☆", tip: "가장 대중적인 전통 마권" },
            { name: "마번쌍승 / 우마탄 (馬単)", jp: "馬単", desc: "1착과 2착마를 순서대로 적중", rate: "75%", diff: "★★★★☆", tip: "우마렌의 2~4배 고배당" },
            { name: "3연복 (3連複)", jp: "3連複", desc: "1, 2, 3착마 3두 적중 (순서 무관)", rate: "75%", diff: "★★★★☆", tip: "만마권 단골 코스" },
            { name: "3연단 (3連単)", jp: "3連単", desc: "1, 2, 3착마를 착순까지 정확히 적중", rate: "72.5%", diff: "★★★★★", tip: "인생 역전 로또급 최고 난도" },
            { name: "WIN5", jp: "WIN5", desc: "일요일 5개 메인 레이스 1착마 연속 적중", rate: "70%", diff: "★★★★★★", tip: "최고 6억 엔 한도의 드림 마권" }
        ];

        function renderBetTypes() {
            document.getElementById('betTypesGrid').innerHTML = BET_TYPES.map(b => `
                <div class="bg-white dark:bg-darkCard p-4 rounded-xl border border-slate-200 dark:border-darkBorder shadow-sm">
                    <div class="flex justify-between items-center">
                        <h4 class="font-bold text-sm">${b.name} <span class="text-xs text-slate-400 font-normal">(${b.jp})</span></h4>
                        <span class="text-xs text-amber-500 font-semibold">${b.diff}</span>
                    </div>
                    <p class="text-xs text-slate-500 mt-1">${b.desc}</p>
                    <div class="flex justify-between items-center mt-3 pt-2 border-t border-slate-100 dark:border-slate-800 text-xs">
                        <span class="text-slate-400">환급률: ${b.rate}</span>
                        <span class="text-blue-500 font-medium">💡 ${b.tip}</span>
                    </div>
                </div>
            `).join('');

            // 파독
            const paddocks = [
                { pt: "1. 걸음걸이 (보법)", gd: "보폭이 넓고 활기차게 뒷다리가 앞다리 자리를 밟고 감", bd: "고개가 들리고 종종걸음처럼 뻣뻣함" },
                { pt: "2. 털의 윤기 (모색)", gd: "햇빛에 반짝이고 동전 모양 얼룩(제니가타) 비침", bd: "털이 푸석하고 윤기 없이 바랜 느낌" },
                { pt: "3. 땀 흘림 (발한)", gd: "목/사타구니에 얇게 촉촉이 맺힘", bd: "하얀 거품이 엉겨붙어 뚝뚝 떨어짐" },
                { pt: "4. 기백과 집중력", gd: "귀를 쫑긋거리며 침착하게 정면 응시", bd: "흰자위를 보이며 거품 물고 요동침" }
            ];
            document.getElementById('paddockList').innerHTML = paddocks.map(p => `
                <div class="p-3 bg-slate-50 dark:bg-slate-800/40 rounded-xl text-xs">
                    <p class="font-bold mb-1">${p.pt}</p>
                    <p class="text-emerald-500">🟢 좋음: ${p.gd}</p>
                    <p class="text-red-400 mt-0.5">🔴 나쁨: ${p.bd}</p>
                </div>
            `).join('');

            // 바바 상태
            const tracks = [
                { cd: "양호 (良)", desc: "마른 최적 상태. 잔디는 선행/선입 유리." },
                { cd: "다습 (稍重)", desc: "약간 촉촉함. 파워형 말들이 두각." },
                { cd: "포화 (重)", desc: "진흙탕. 잔디는 체력 소모 극심, 더트는 모래가 굳어 초고속 마장 변모!" },
                { cd: "불량 (不良)", desc: "수중전. 앞선 말이 진흙을 튀겨 도주마 극도로 유리." }
            ];
            document.getElementById('trackCondList').innerHTML = tracks.map(t => `
                <div class="p-3 bg-slate-50 dark:bg-slate-800/40 rounded-xl text-xs">
                    <p class="font-bold text-amber-500 mb-0.5">${t.cd}</p>
                    <p class="text-slate-400">${t.desc}</p>
                </div>
            `).join('');
        }

        // 계산기 이벤트
        function calcOdds() {
            const amount = parseFloat(document.getElementById('calcAmount').value) || 0;
            const odds = parseFloat(document.getElementById('calcOdds').value) || 1.0;

            const payout = Math.floor(amount * odds);
            const profit = payout - amount;
            const krw = Math.floor(payout * 9.1);

            document.getElementById('resCost').innerText = `¥${amount.toLocaleString()}`;
            document.getElementById('resPayout').innerText = `¥${payout.toLocaleString()}`;
            document.getElementById('resProfit').innerText = `${profit >= 0 ? '+' : ''}¥${profit.toLocaleString()}`;
            document.getElementById('resKrw').innerText = `약 ${krw.toLocaleString()}원`;
        }

        document.getElementById('calcAmount').addEventListener('input', calcOdds);
        document.getElementById('calcOdds').addEventListener('input', calcOdds);

        // ==========================
        // 6. 명예의 전당 & 랭킹
        // ==========================
        function renderHallOfFame() {
            const earnings = [
                { rank: "1위", name: "이퀴녹스", money: "22억 1,544만 엔", note: "세계 랭킹 1위" },
                { rank: "2위", name: "우슈바 테소로", money: "22억 1,000만 엔", note: "두바이 월드컵 우승" },
                { rank: "3위", name: "아몬드 아이", money: "19억 1,526만 엔", note: "잔디 G1 9승" },
                { rank: "4위", name: "키타산 블랙", money: "18억 6,687만 엔", note: "G1 7승 & 명종마" },
                { rank: "5위", name: "티엠 오페라 오", money: "18억 3,518만 엔", note: "세기말 패왕 8연승" },
                { rank: "6위", name: "오르페브르", money: "15억 7,621만 엔", note: "삼관마 & 폭군" },
                { rank: "7위", name: "젠틸돈나", money: "15억 6,700만 엔", note: "암말 삼관 & 재팬컵" },
                { rank: "8위", name: "딥 임팩트", money: "14억 5,455만 엔", note: "무패 삼관 & 전설" }
            ];
            document.getElementById('earningsTable').innerHTML = earnings.map(e => `
                <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30">
                    <td class="py-2.5 font-bold ${e.rank.includes('1') ? 'text-amber-500' : ''}">${e.rank}</td>
                    <td class="py-2.5 font-semibold">${e.name}</td>
                    <td class="py-2.5 text-amber-500 font-bold">${e.money}</td>
                    <td class="py-2.5 text-slate-400 text-xs">${e.note}</td>
                </tr>
            `).join('');

            const triple = [
                { year: 1941, name: "세인트 라이트", note: "초대 삼관마" },
                { year: 1964, name: "신잔 (神賛)", note: "오관마의 시조" },
                { year: 1983, name: "미스터 CB", note: "후방 추입의 미학" },
                { year: 1984, name: "심볼리 루돌프", note: "최초의 무패 삼관(황제)" },
                { year: 1994, name: "나리타 브라이언", note: "괴물, 압도적 차이" },
                { year: 2005, name: "딥 임팩트", note: "21세기 무패 삼관" },
                { year: 2011, name: "오르페브르", note: "금색의 폭군" },
                { year: 2020, name: "콘트레일", note: "부자(父子) 무패 삼관" }
            ];
            document.getElementById('tripleCrownTable').innerHTML = triple.map(t => `
                <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30">
                    <td class="py-2.5 text-slate-400">${t.year}</td>
                    <td class="py-2.5 font-semibold">${t.name}</td>
                    <td class="py-2.5 text-xs text-blue-400">${t.note}</td>
                </tr>
            `).join('');
        }

        // 초기화 실행
        window.addEventListener('DOMContentLoaded', () => {
            updateHorseProfile("이퀴녹스");
            renderRaces();
            renderJockeys();
            initComparison();
            initMap();
            renderTrackButtons();
            renderBetTypes();
            calcOdds();
            renderHallOfFame();
        });
    </script>
</body>
</html>

