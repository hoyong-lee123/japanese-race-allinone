                g1: ["11 사츠키상", "11 일본 더비", "11 킷카상 (삼관)", "11 아리마 기념", "12 타카라즈카", "13 아리마 기념 (8마신차)"],
                stats: [96, 98, 97, 99, 95, 82]
            },
            "키타산 블랙": {
                jp: "キタサンブラック (Kitasan Black)",
